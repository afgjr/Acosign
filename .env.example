# Copy this file to .env and fill in real values.
# .env is git-ignored; never commit secrets.

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://insa_user:secure_password@localhost:5432/audio_signature_db

# ── Audio loading ─────────────────────────────────────────────────────────────
SAMPLE_RATE=22050
MIN_AUDIO_DURATION=1.0

# ── Spectrogram ───────────────────────────────────────────────────────────────
N_FFT=4096
HOP_LENGTH=2048
TOP_DB=80.0

# ── Peak detection ────────────────────────────────────────────────────────────
PEAK_NEIGHBORHOOD_SIZE=10
MIN_AMPLITUDE=10.0

# ── Hash generation ───────────────────────────────────────────────────────────
FAN_OUT=5
MIN_DELTA_T=1
MAX_DELTA_T=200

# ── Matching ──────────────────────────────────────────────────────────────────
MIN_MATCH_SCORE=5

# ── UI service (used by docker-compose only) ──────────────────────────────────
API_URL=http://api:8000
