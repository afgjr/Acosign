# Copy this file to .env and fill in real values.
# .env is git-ignored; never commit secrets.

# ── Database ──────────────────────────────────────────────────────────────────
# localhost:5433 is for running the app on your PC; inside Docker the host is db:5432 (set automatically by compose)
POSTGRES_USER=insa_user
POSTGRES_PASSWORD=secure_password
POSTGRES_DB=audio_signature_db
DATABASE_URL=postgresql://insa_user:secure_password@localhost:5433/audio_signature_db

# ── Audio loading ─────────────────────────────────────────────────────────────
SAMPLE_RATE=22050
MIN_AUDIO_DURATION=1.0
MAX_DECODE_SECONDS=600

# ── Spectrogram ───────────────────────────────────────────────────────────────
N_FFT=4096
HOP_LENGTH=2048
TOP_DB=80.0

# ── Peak detection ────────────────────────────────────────────────────────────
PEAK_NEIGHBORHOOD_SIZE=20
MIN_AMPLITUDE=10.0

# ── Hash generation ───────────────────────────────────────────────────────────
FAN_OUT=10
MIN_DELTA_T=1
MAX_DELTA_T=200

# ── Matching ──────────────────────────────────────────────────────────────────
MIN_MATCH_SCORE=5

# ── API & Thresholds ──────────────────────────────────────────────────────────
MAX_UPLOAD_MB=25
DUPLICATE_SCORE=200
MIN_QUERY_SECONDS=3.0
MAX_QUERY_SECONDS=20
STRONG_SCORE=30
CORS_ORIGINS=*
# ── Administrative Protection ─────────────────────────────────────────────
# Secret key required for POST /register and DELETE /tracks endpoints
ADMIN_API_KEY=change_me_admin_key

# ── UI Service Configuration ──────────────────────────────────────────────
# Base URL of the backend API for Streamlit UI (http://localhost:8000 for local, http://api:8000 for docker-compose)
API_URL=http://localhost:8000
